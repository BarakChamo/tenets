{
	"name": "@tenets/env",
	"version": "0.6.0",
	"description": "Composable typed environment contracts on Zod 4.6 with a cached schema per definition, server/client partitions, deployed-environment rules, and an optional Next.js adapter \u2014 the boundary-validation layer the tenets ruleset prescribes (Rule 2.1).",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/BarakChamo/tenets.git",
		"directory": "packages/env"
	},
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./next": {
			"types": "./dist/typed-env/next.d.ts",
			"import": "./dist/typed-env/next.js"
		},
		"./node": {
			"types": "./dist/node.d.ts",
			"import": "./dist/node.js"
		}
	},
	"files": [
		"dist",
		"src"
	],
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"prepublishOnly": "npm run build"
	},
	"peerDependencies": {
		"zod": "^4.6.0"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	}
}